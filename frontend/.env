# Overwatch Frontend Configuration
# All backend URLs are now computed from these settings

# Backend Configuration
REACT_APP_BACKEND_HOST=10.236.209.130
REACT_APP_BACKEND_PORT=8000
REACT_APP_BACKEND_PROTOCOL=wss
REACT_APP_API_PROTOCOL=https

# WebSocket Configuration
REACT_APP_WS_MAX_RECONNECT=5
REACT_APP_WS_RECONNECT_DELAY=1000
REACT_APP_WS_PING_INTERVAL=20000

# Camera Configuration
REACT_APP_MAX_CAMERAS=4
REACT_APP_CAMERA_INACTIVITY_TIMEOUT=3000
REACT_APP_FPS_UPDATE_INTERVAL=1000

# Mobile Camera Configuration
REACT_APP_MOBILE_TARGET_FPS=15
REACT_APP_MOBILE_JPEG_QUALITY=0.5
REACT_APP_MOBILE_MAX_WIDTH=640
REACT_APP_MOBILE_SENSOR_INTERVAL=500

# Display Configuration
REACT_APP_PERSON_HEIGHT_METERS=1.7
REACT_APP_REF_PX_AT_1M=520