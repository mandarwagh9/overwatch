# =============================================================================
# Overwatch Backend Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# All values are loaded via Pydantic settings with validation.
# =============================================================================

# --- Server Configuration ---
HOST=0.0.0.0
PORT=8000
DEBUG=false
LOG_LEVEL=INFO

# --- Camera Configuration ---
# Maximum number of cameras (physical + virtual)
MAX_CAMERAS=4

# Target processing FPS
TARGET_FPS=24

# Frame dimensions
FRAME_WIDTH=1280
FRAME_HEIGHT=720

# Camera URLs (RTSP streams, HTTP URLs, or device indices)
# Format: Comma-separated list or individual CAM_X_URL variables
# Examples:
#   CAMERA_URLS=["rtsp://192.168.1.100:554/stream", "http://192.168.1.101:8080/video"]
#   CAM_0_URL=0  # Local camera device 0
#   CAM_1_URL=http://192.168.1.100:8080/video
CAMERA_URLS=[]

# Camera world positions in meters [x, y, z]
# Must provide one position per camera
# Example: [[0, 0, 2], [5, 0, 2], [0, 5, 2], [-5, 0, 2]]
CAMERA_POSITIONS=[]

# --- Detection Configuration ---
MODEL_PATH=yolov8n.pt
CONFIDENCE_THRESHOLD=0.5
IOU_THRESHOLD=0.45
MAX_DETECTIONS=100
DETECTION_CLASSES=[0]

# Hardware settings
DEVICE=auto
HALF_PRECISION=false

# --- Tracking Configuration ---
TRACKING_MAX_AGE=30
TRACKING_MIN_HITS=3
TRACKING_IOU_THRESHOLD=0.25
TRACKING_APPEARANCE_WEIGHT=0.4

# --- WebSocket Configuration ---
WS_MAX_SIZE=16777216
WS_PING_INTERVAL=20
WS_PING_TIMEOUT=20

# --- SSL Configuration ---
SSL_ENABLED=true
SSL_CERTFILE=certs/cert.pem
SSL_KEYFILE=certs/key.pem

# --- Mobile Camera Configuration ---
MOBILE_CAMERA_FPS=15
MOBILE_CAMERA_QUALITY=50
MOBILE_CAMERA_MAX_WIDTH=640

# --- JWT Authentication ---
# IMPORTANT: Change this in production!
JWT_SECRET=your-secret-key-here-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
AUTH_ENABLED=false

# --- World Model Configuration ---
PERSON_HEIGHT_METERS=1.7
PREDICTION_HORIZON_SECONDS=5.0
WORLD_OBJECT_MAX_AGE_SECONDS=5.0

# --- Homography Configuration ---
HOMOGRAPHY_MIN_PAIRS=4
HOMOGRAPHY_MAX_PAIRS=100
HOMOGRAPHY_RANSAC_THRESHOLD=12.0
HOMOGRAPHY_MOVEMENT_THRESHOLD=1.0

# --- GPS Reference (optional) ---
# Used for GPS coordinate to local coordinate conversion
GPS_REFERENCE_LAT=
GPS_REFERENCE_LNG=
