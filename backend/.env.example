# =============================================================================
# Overwatch Backend — Environment Configuration
# =============================================================================
# Copy this to .env on the Jetson Orin Nano and uncomment the lines below.
# Pydantic-settings will load these automatically.
# =============================================================================

# --- Jetson Orin Nano optimized settings ---
# MODEL_PATH=yolov8n.engine
# DEVICE=cuda:0
# HALF_PRECISION=true

# --- Person-only detection (COCO class 0) ---
# Already default in config.py; override here if needed:
# DETECTION_CLASSES=[0]

# --- Confidence threshold (lower = more detections, higher = fewer false positives) ---
# CONFIDENCE_THRESHOLD=0.5

# --- SSL ---
# SSL_ENABLED=true
# SSL_CERTFILE=certs/cert.pem
# SSL_KEYFILE=certs/key.pem
